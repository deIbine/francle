# Fins de ligne normalisées en LF dans le dépôt,
# converties selon le système de chacun à l'extraction.
* text=auto

*.java text diff=java
*.md   text
*.txt  text

# Fichiers binaires : aucune conversion
*.png  binary
*.jpg  binary
*.docx binary
*.pptx binary

# Scripts : fins de ligne imposées quel que soit le système
# (un script shell en CRLF échoue sous Linux, un .cmd en LF peut échouer sous Windows)
mvnw   text eol=lf
*.sh   text eol=lf
*.cmd  text eol=crlf
